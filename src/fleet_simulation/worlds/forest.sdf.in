      <direction>-0.3 0.2 -0.9</direction>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.4 0.4 0.35 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

