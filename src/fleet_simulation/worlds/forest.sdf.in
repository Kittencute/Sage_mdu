          <material>
            <ambient>0.3 0.25 0.15 1</ambient>
            <diffuse>0.35 0.3 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

