<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>madum_bridge</name>
  <version>0.1.0</version>
  <description>MQTT bridge between the MADUM protocol and the fleet mission contract: vehicle state, summary, alarms and mission handling for one vehicle</description>
  <maintainer email="emil.persson@mdu.se">Emil Persson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <depend>rclpy</depend>
  <depend>fleet_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>fleet_common</depend>

  <exec_depend>mqtt_client</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
