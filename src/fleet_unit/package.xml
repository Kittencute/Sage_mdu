<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_unit</name>
  <version>0.1.0</version>
  <description>Runs one robot unit from its rendered manifest: supervises its processes and publishes the unit description and health</description>
  <maintainer email="emil.persson@mdu.se">Emil Persson</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>fleet_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>composition_interfaces</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2pkg</exec_depend>
  <exec_depend>ros2run</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>fleet_common</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
